# ─────────────────────────────────────────────────────────────
# agent-api server
# ─────────────────────────────────────────────────────────────

# Server
PORT=3002
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production

# MCP + LLM
MCP_URL=http://mcp-server:3001/sse
OLLAMA_HOST=http://ollama:11434
LLM_MODEL=qwen2.5:3b

# Floci (DynamoDB local emulator)
FLOCI_ENDPOINT=http://floci:4566

# ─────────────────────────────────────────────────────────────
# HMAC auth (v1.2)
# ─────────────────────────────────────────────────────────────
# v1.2 (PRD §13 H-02): HMAC se aplica como hook global onRequest
# a todos los endpoints /api, salvo los de la allowlist
# (/health, /api/auth/config en dev, /).
#
# v1.2 (PRD §13 H-04): la firma incluye la query string ordenada
# alfabéticamente. El prompt del usuario queda así vinculado a la
# petición.
#
# v1.2 (PRD §13 H-05): ventana anti-replay reducida a 60 s (antes
# 300 s) y se exige nonce único por request (X-Floci-Nonce).
# El servidor rechaza peticiones con nonce repetido dentro de la
# ventana.
#
# v1.3 (PRD §4, §13 H-03): identidad lógica del llamante firmada
# en la cadena canónica. El navegador la envía como X-Floci-Subject;
# el servidor la usa para autorizar acceso a sesiones (404 si la
# sesión pertenece a otro subject). En producción será el `sub` del
# OIDC; en dev single-tenant se reutiliza HMAC_KEY_ID.
#
# Generate a strong secret with: openssl rand -hex 32
HMAC_SECRET=
HMAC_KEY_ID=default
HMAC_WINDOW_SECONDS=60

# v1.3 H-03: subject por defecto cuando el cliente no envía
# X-Floci-Subject. Útil durante la transición desde v1.2.x.
# En v2.0 este fallback caerá y el header será obligatorio.
# HMAC_SUBJECT=default

# Optional escape hatch for local dev only. When "false", requests
# without valid signatures are still accepted (with a WARN log).
# DO NOT enable in production.
HMAC_AUTH_ENABLED=true

# ─────────────────────────────────────────────────────────────
# CORS allowlist (v1.2 PRD §13 H-01)
# ─────────────────────────────────────────────────────────────
# CSV de orígenes permitidos. Prohibido "*" y prohibido origin: true.
# En producción, configurar con el dominio público del front.
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://localhost:5173
