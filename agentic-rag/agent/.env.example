# ─────────────────────────────────────────────────────────────
# agent-api server
# ─────────────────────────────────────────────────────────────

# Server
PORT=3002
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production

# MCP + LLM
MCP_URL=http://mcp-server:3001/sse
OLLAMA_HOST=http://ollama:11434
LLM_MODEL=qwen2.5:3b

# Floci (DynamoDB local emulator)
FLOCI_ENDPOINT=http://floci:4566

# ─────────────────────────────────────────────────────────────
# HMAC auth (v1.1.0)
# ─────────────────────────────────────────────────────────────
# Set HMAC_SECRET and HMAC_KEY_ID to enable HMAC validation on
# /api/chat and /api/chat/stream. Without these, the auth hook
# throws at boot — there is no "open by default" mode in prod.
#
# Generate a strong secret with: openssl rand -hex 32
HMAC_SECRET=
HMAC_KEY_ID=default
HMAC_WINDOW_SECONDS=300

# Optional escape hatch for local dev only. When "true", requests
# without valid signatures are still accepted (with a WARN log).
# DO NOT enable in production.
HMAC_AUTH_ENABLED=true
