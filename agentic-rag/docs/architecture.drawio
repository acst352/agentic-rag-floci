                <mxCell id="legend_title" value="Leyenda — Producción (AWS) → Local (este repo)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=none;strokeColor=none;" parent="1" vertex="1">
