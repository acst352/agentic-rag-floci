# Copia a compose/.env y personaliza. compose/.env está en .gitignore.
#
# Tip: ejecuta `make init-env` para generar compose/.env automáticamente
# con un HMAC_SECRET aleatorio.

# ─────────────────────────────────────────────────────────────
# HMAC auth (v1.1.0) — REQUERIDO por agent-api
# ─────────────────────────────────────────────────────────────
# Genera uno con: openssl rand -hex 32
HMAC_SECRET=
HMAC_KEY_ID=local-dev
HMAC_WINDOW_SECONDS=300

# Solo para desarrollo local. NO activar en producción.
HMAC_AUTH_ENABLED=true
