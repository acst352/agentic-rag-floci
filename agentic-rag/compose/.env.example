# Copia a compose/.env y personaliza. compose/.env está en .gitignore.
#
# Tip: ejecuta `make init-env` para generar compose/.env automáticamente
# con un HMAC_SECRET aleatorio.

# ─────────────────────────────────────────────────────────────
# HMAC auth (v1.1.0) — REQUERIDO por agent-api
# ─────────────────────────────────────────────────────────────
# Genera uno con: openssl rand -hex 32
HMAC_SECRET=
HMAC_KEY_ID=local-dev
HMAC_WINDOW_SECONDS=300

# Solo para desarrollo local. NO activar en producción.
HMAC_AUTH_ENABLED=true

# ─────────────────────────────────────────────────────────────
# Ingestion pipeline (v1.5.0)
# ─────────────────────────────────────────────────────────────
# JOBS_STORE=dynamo  → producción: persiste jobs en DynamoDB (Floci).
# JOBS_STORE=memory  → dev/test: jobs en memoria (se pierden al
#                      parar el proceso). Útil para smoke tests.
JOBS_STORE=dynamo

# Tabla DynamoDB donde se persisten los IngestionJob (cuando
# JOBS_STORE=dynamo). La tabla debe existir con PK=job_id (String).
JOBS_TABLE=ingestion_jobs

# Región AWS para el cliente DynamoDB.
AWS_REGION=us-east-1
